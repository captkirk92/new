{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "shared/**/*",
    "colorful-marquee.tsx",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "figma-plugin",
    "chrome-extension",
    "dist",
    "build"
  ]
}
